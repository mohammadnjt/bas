# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: The port that the Orchestrator panel runs on (default: 3000)
PORT=3000

# ADMIN_USERNAME: Username required to access the Orchestrator panel
ADMIN_USERNAME=admin

# ADMIN_PASSWORD: Password required to access the Orchestrator panel (defaults to 'admin' if empty)
ADMIN_PASSWORD=

# UNAUTHORIZED_REDIRECT_URL: URL to redirect unauthorized visitors to instead of showing the lock screen.
# Example: https://your.domain.ir
UNAUTHORIZED_REDIRECT_URL=

# ALLOWED_IPS: Comma-separated list of IPs allowed to access the panel. Leave blank to allow all IPs.
# Example: 192.168.1.100,10.0.0.5
ALLOWED_IPS=

# SMS_API_URL: The base URL for the SMS gateway API
# Example: https://your-sms-provider.com/api/send
SMS_API_URL=

# SMS_APIKEY_BAS: The secret API key for the SMS gateway
SMS_APIKEY_BAS=
